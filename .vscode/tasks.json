{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve: github-pages-local",
      "type": "shell",
      "command": "/usr/bin/python3",
      "args": ["-m", "http.server", "5500"],
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "line": 1,
              "column": 1,
              "message": 1
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^",
            "endsPattern": "Serving HTTP on"
          }
        }
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
